<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
    <ProjectReference Include="..\..\VipCoreApi\VipCoreApi.csproj">
      <Private>False</Private>
    </ProjectReference>
    <!-- MenuManagerCS2 (NickFox007) public API. Compile-time only; the real DLL ships with
         MenuManagerCS2 on the server. Private=false so no local copy is emitted. -->
    <Reference Include="MenuManagerApi">
      <HintPath>3rd_party\MenuManagerApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
